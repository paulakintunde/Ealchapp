      "id": "sc.a1.marche.001",
      "level": "a1",
      "theme": "marche",
      "title": "Au marché",
      "turns": [
        {
          "ai": "Bonjour ! Vous désirez ?",
          "en": "Hello! What would you like?",
          "user": "Trois pommes, s'il vous plaît."
        },
        {
          "ai": "Voilà. Autre chose ?",
          "en": "Here you go. Anything else?",
          "user": "Non, merci. C'est combien ?"
        },
        {
          "ai": "Deux euros cinquante.",
          "en": "Two euros fifty.",
          "user": "Voilà. Merci, au revoir !"
        }
      ],
      "version": 1
    },
    {
      "id": "sc.a2.marche.001",
      "level": "a2",
      "theme": "marche",
      "title": "Au marché",
      "turns": [
        {
          "ai": "Bonjour ! Les fraises sont en promotion aujourd'hui.",
          "en": "The strawberries are on sale today.",
          "user": "Elles viennent d'où, vos fraises ?"
        },
        {
          "ai": "De Bretagne — cueillies ce matin. Une barquette ?",
          "en": "From Brittany — picked this morning.",
          "user": "J'en prends deux, et un kilo de tomates."
        },
        {
          "ai": "Et avec ceci ? Ça vous fait neuf euros vingt.",
          "en": "Anything else? That's €9.20.",
          "user": "C'est tout. Tenez, dix euros."
        }
      ],
      "version": 1
    }
  ]
