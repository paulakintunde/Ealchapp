  "lessons": [
    {
      "id": "sons.03.l1",
      "seq": 1,
      "tag": "SONS · LEÇON 03",
      "intro": "Four sounds with no English equivalent. The air escapes through the nose — the n or m is never pronounced as a consonant. Master these and you instantly sound less foreign.",
      "level": "sons",
      "title": "Les voyelles nasales",
      "unitId": "sons.03",
      "itemIds": [
        "fr.a1.cafe.001",
        "fr.a1.objets.001",
        "fr.a1.objets.002",
        "fr.a1.cafe.007",
        "fr.a1.cafe.008"
      ],
      "version": 1,
      "sections": [
        {
          "cols": [
            "Spelling",
            "Sound",
            "Example"
          ],
          "rows": [
            [
              "on · om",
              "ɔ̃",
              "bon, nom"
            ],
            [
              "en · an · em",
              "ɑ̃",
              "vent, blanc"
            ],
            [
              "in · ain · ein",
              "ɛ̃",
              "vin, pain"
            ],
            [
              "un · um",
              "œ̃",
              "un, parfum"
            ]
          ],
          "type": "table",
          "title": "Reference"
        },
        {
          "type": "examples",
          "title": "Examples",
          "examples": [
            {
              "en": "A good white wine — all four nasals in one phrase",
              "fr": "Un bon vin blanc"
            },
            {
              "en": "My uncle is eleven — chained ɔ̃ sounds",
              "fr": "Mon oncle a onze ans"
            }
          ]
        },
        {
          "type": "audio",
          "lines": [
            "Un bon vin blanc",
            "Mon oncle adore le parfum",
            "Le pain est en train de cuire"
          ],
          "title": "Listen"
        },
        {
          "type": "commonErrors",
          "title": "Common errors",
          "errors": [
            {
              "why": "Pronouncing the n turns the nasal into an oral vowel + consonant — the single most-heard beginner error.",
              "right": "bon = bɔ̃ (no n sound)",
              "wrong": "bon → \" bonne \""
            },
            {
              "why": "English speakers close the vowel. Keep the mouth open, push air through the nose.",
              "right": "vin = vɛ̃",
              "wrong": "vin = \" veen \""
            }
          ]
        },
        {
          "type": "practice",
          "skill": "speak",
          "title": "Practice",
          "itemIds": [
            "fr.a1.cafe.001",
            "fr.a1.objets.001",
            "fr.a1.objets.002",
            "fr.a1.cafe.007",
            "fr.a1.cafe.008"
          ]
        },
        {
          "type": "quiz",
          "title": "Quiz",
          "questions": [
            {
              "q": "Which word contains the sound ɔ̃ ?",
              "opts": [
                "vin",
                "nom",
                "vent"
              ],
              "correct": 1
            },
            {
              "q": "In « un bon vin blanc », how many DIFFERENT nasal vowels appear?",
              "opts": [
                "2",
                "3",
                "4"
              ],
              "correct": 2
            },
            {
              "q": "The n in a nasal vowel is…",
              "opts": [
                "pronounced softly",
                "never pronounced",
                "pronounced at the end"
              ],
              "correct": 1
            }
          ]
        }
      ]
    },
    {
      "id": "a1.04.l1",
      "seq": 1,
      "tag": "A1 · LEÇON 04",
      "intro": "French has four ways to say « the », and the choice depends on the noun’s gender, number, and first letter. There is no way around them — every noun you ever use will need one.",
      "level": "a1",
      "title": "Les articles définis",
      "unitId": "a1.04",
      "itemIds": [
        "fr.a1.objets.004",
        "fr.a1.cafe.004",
        "fr.a1.dictee.002",
        "fr.a1.dictee.003"
      ],
      "version": 1,
      "sections": [
        {
          "cols": [
            "Article",
            "Used for",
            "Example"
          ],
          "rows": [
            [
              "le",
              "masculine",
              "le café"
            ],
            [
              "la",
              "feminine",
              "la maison"
            ],
            [
              "l'",
              "before a vowel or h",
              "l'eau, l'homme"
            ],
            [
              "les",
              "all plurals",
              "les amis"
            ]
          ],
          "type": "table",
          "title": "Reference"
        },
        {
          "type": "examples",
          "title": "Examples",
          "examples": [
            {
              "en": "The sun and the moon — gender is arbitrary; learn it with the noun",
              "fr": "Le soleil et la lune"
            },
            {
              "en": "I love summer — l’ before the vowel, and note: French uses « the » where English drops it",
              "fr": "J'aime l'été"
            }
          ]
        },
        {
          "type": "audio",
          "lines": [
            "Le café, s'il vous plaît",
            "L'addition et la carte",
            "Les amis arrivent"
          ],
          "title": "Listen"
        },
        {
          "type": "commonErrors",
          "title": "Common errors",
          "errors": [
            {
              "why": "Two vowel sounds may not collide — the e elides. This is élision, and it is mandatory.",
              "right": "« l'eau »",
              "wrong": "« le eau »"
            },
            {
              "why": "Before a vowel, the s of les must be pronounced as z.",
              "right": "« les‿amis » (lé-zami)",
              "wrong": "« les ami » (no liaison)"
            }
          ]
        },
        {
          "type": "practice",
          "skill": "read",
          "title": "Practice",
          "itemIds": [
            "fr.a1.objets.004",
            "fr.a1.cafe.004",
            "fr.a1.dictee.002",
            "fr.a1.dictee.003"
          ]
        },
        {
          "type": "quiz",
          "title": "Quiz",
          "questions": [
            {
              "q": "« ___ école » (school, feminine)",
              "opts": [
                "la école",
                "l'école",
                "le école"
              ],
              "correct": 1
            },
            {
              "q": "The article for ALL plural nouns is…",
              "opts": [
                "les",
                "las",
                "los"
              ],
              "correct": 0
            },
            {
              "q": "In « les‿amis », the s sounds like…",
              "opts": [
                "s",
                "silent",
                "z"
              ],
              "correct": 2
            }
          ]
        }
      ]
    },
    {
      "id": "a2.01.l1",
      "seq": 1,
      "tag": "A2 · LEÇON 01",
      "intro": "About 90% of French verbs are regular -ER verbs. Learn one conjugation pattern and you unlock thousands of verbs at once. This unit has four sub-lessons — start with the full -ER system.",
      "level": "a2",
      "title": "Verbes réguliers",
      "unitId": "a2.01",
      "itemIds": [
        "fr.a2.verbes.001",
        "fr.a2.verbes.002",
        "fr.a2.verbes.003",
        "fr.a2.verbes.004",
        "fr.a2.verbes.005",
        "fr.a1.dictee.003"
      ],
      "version": 1,
      "sections": [
        {
          "cols": [
            "parler",
            "Ending",
            "Sounds like"
          ],
          "rows": [
            [
              "je parle",
              "-e",
              "parl"
            ],
            [
              "tu parles",
              "-es",
              "parl"
            ],
            [
              "il / elle parle",
              "-e",
              "parl"
            ],
            [
              "nous parlons",
              "-ons",
              "par-lõ"
            ],
            [
              "vous parlez",
              "-ez",
              "par-lé"
            ],
            [
              "ils parlent",
              "-ent",
              "parl (silent!)"
            ]
          ],
          "type": "table",
          "title": "Reference"
        },
        {
          "type": "examples",
          "title": "Examples",
          "examples": [
            {
              "en": "They speak French — the -ent is completely silent",
              "fr": "Ils parlent français"
            },
            {
              "en": "We eat — manger keeps the e before -ons (a spelling quirk, see sub-lesson 2)",
              "fr": "Nous mangeons"
            }
          ]
        },
        {
          "type": "audio",
          "lines": [
            "Je parle, tu parles, il parle",
            "Nous parlons français ensemble",
            "Elles écoutent la radio"
          ],
          "title": "Listen"
        },
        {
          "type": "commonErrors",
          "title": "Common errors",
          "errors": [
            {
              "why": "Only tu takes the s. Four of the six forms sound identical — the spelling differs.",
              "right": "« je parle »",
              "wrong": "« je parles »"
            },
            {
              "why": "The third-person plural ending is written but never voiced.",
              "right": "« parl » — the -ent is silent",
              "wrong": "pronouncing « ils parlent » as \" parlont \""
            }
          ]
        },
        {
          "type": "focus",
          "title": "In this unit",
          "points": [
            "Regular -ER Verbs — The Full System",
            "-ER Verbs — Spelling Quirks",
            "Regular -IR Verbs",
            "Regular -RE Verbs"
          ]
        },
        {
          "type": "practice",
          "skill": "write",
          "title": "Practice",
          "itemIds": [
            "fr.a2.verbes.001",
            "fr.a2.verbes.002",
            "fr.a2.verbes.003",
            "fr.a2.verbes.004",
            "fr.a2.verbes.005",
            "fr.a1.dictee.003"
          ]
        },
        {
          "type": "quiz",
          "title": "Quiz",
          "questions": [
            {
              "q": "« Nous ___ » (parler)",
              "opts": [
                "parlons",
                "parlez",
                "parlent"
              ],
              "correct": 0
            },
            {
              "q": "How is the -ent in « ils parlent » pronounced?",
              "opts": [
                "\" ent \"",
                "\" on \"",
                "it is silent"
              ],
              "correct": 2
            },
            {
              "q": "Which forms of parler SOUND identical?",
              "opts": [
                "je / nous / vous",
                "je / tu / il / ils",
                "tu / vous"
              ],
              "correct": 1
            }
          ]
        }
