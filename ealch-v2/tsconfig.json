{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The import-free schema files (src/content/schema.ts, progress-schema.ts)
    // are loaded by `node --test` directly, and Node's ESM resolver does not do
    // extensionless resolution — so progress-schema.ts must import './schema.ts'
    // with the extension or the test run cannot resolve it. Metro resolves the
    // explicit extension fine, and this project never emits with tsc (noEmit is
    // set by expo/tsconfig.base), which is the condition TypeScript requires for
    // this option. The test files already rely on the same specifier style; they
    // are simply excluded from tsc below, which is why this only surfaced now.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "css.d.ts"
  ],
  // *.test.ts files run under plain Node (node --test), not Metro.
  // supabase/functions/* is Deno, not React Native: it imports from jsr: and
  // uses the Deno global, neither of which exists in the app's type world.
  // Those files are typechecked by `deno check` / on deploy, not by tsc here.
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "supabase/functions"
  ]
}
