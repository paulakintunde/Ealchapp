{
  "expo": {
    "name": "Ealch",
    "slug": "wonerock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ealch",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f7effa79-feb1-4e79-a567-536e32da5306"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ealch.mobile",
      "icon": {
        "light": "./assets/ios-icon-light.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      }
    },
    "android": {
      "package": "app.ealch.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0B0C0E",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2FD6C1"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ealch uses the microphone so you can speak French out loud and get feedback on what you said.",
          "speechRecognitionPermission": "Ealch uses speech recognition to compare what you said with the phrase you are practising.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7effa79-feb1-4e79-a567-536e32da5306"
      }
    },
    "owner": "wonerocks-team"
  }
}
