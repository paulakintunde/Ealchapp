# Ealch v2 — environment. Copy to `.env`. Every value is optional: with none set,
# the app runs fully offline using on-device speech and simulated coaching.
# Only NON-SECRET references live on the client. Provider API keys stay server-side
# in Supabase Edge Functions.

# Supabase (control plane, auth, storage, edge functions)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge Function slugs (proxy paid providers; secrets injected server-side)
EXPO_PUBLIC_COACH_FN=coach
EXPO_PUBLIC_TTS_FN=tts
EXPO_PUBLIC_STT_FN=stt

# RevenueCat public SDK key (paywall)
EXPO_PUBLIC_REVENUECAT_KEY=

# PostHog (analytics + failover events)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
