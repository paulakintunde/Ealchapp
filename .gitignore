# Playwright MCP scratch output — console logs, page snapshots, screenshots
.playwright-mcp/

# Markdown docs/scratch — planning prompts, audits, notes. The 46 .md files
# already tracked stay tracked (git does not untrack on ignore); this only
# stops NEW .md from cluttering status/commits. To track a new one anyway:
# git add -f <file>.md
*.md

# Camille avatar concept art exploration — large PNGs, not yet finalized.
camille-concepts/

# Device screenshots taken while proving a lesson on the phone. They are named
# after whatever was being checked at the time (s08-m07-beatrow.png,
# ob-step7b.png) and are worth nothing once the fix they document is committed.
# ~75 of them had piled up in the repo root, which is how an unrelated change
# hid in `git status` long enough to reach a commit unnoticed. Screenshots that
# are worth keeping belong in a named folder, not at the root.
/*.png
s05-device-shots/

# Metro bundler log — regenerated on every dev server start.
ealch-v2/metro.log

# Python bytecode from the gates/*.py subprocess gates.
__pycache__/

# Scratch scripts. `_tmp_` is the prefix for something written to answer one
# question and not meant to survive it.
ealch-admin/scripts/_tmp_*.ts

# Seed snapshots taken around a migration. A copy of seed.json is ~15 MB and
# carries the SAME `version` field as the real one while holding an older body,
# so a stray `git add -A` commits 30 MB and a stray copy silently restores a
# state the counter says is current. Two of them are sitting beside seed.json
# right now, from the band-wide unit-label migration that was rolled back in
# favour of the source-first one.
ealch-v2/src/content/seed.*.bak
ealch-v2/src/content/seed.*.migrated.json

# The rolled-back migration's own script. Kept as a record of what was tried;
# ignored because its `--write` still writes seed.json AND Postgres directly,
# bypassing the batch-then-merge pipeline every lesson goes through.
ealch-admin/scripts/_a2_unit_label_migration.ts
